{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Black Box: probe loop",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["probe", "loop", "--data-dir", "${workspaceFolder}/data"],
      "console": "integratedTerminal"
    },
    {
      "name": "Black Box: probe once",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["probe", "once", "--data-dir", "${workspaceFolder}/data"],
      "console": "integratedTerminal"
    },
    {
      "name": "Black Box: show recent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["show", "recent", "--data-dir", "${workspaceFolder}/data"],
      "console": "integratedTerminal"
    },
    {
      "name": "Black Box: tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal"
    }
  ]
}
